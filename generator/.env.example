# Copy to .env (git-ignored) or set these in your shell before running potch_generator.py.
# Event Hubs namespace connection string with a Send policy (Event Hubs namespace -> Shared access policies)
EVENTHUB_CONNECTION_STR=Endpoint=sb://<namespace>.servicebus.windows.net/;SharedAccessKeyName=<policy>;SharedAccessKey=<key>
HUB_IOT=evh-potchiot-dev-italynorth
HUB_SOCIAL=evh-potchsocial-dev-italynorth
HUB_FLEET=evh-potchfleet-dev-italynorth

# Cosmos DB account (Keys blade)
COSMOS_URI=https://<account>.documents.azure.com:443/
COSMOS_KEY=<primary-key>
COSMOS_DB=PotchSmartCity
